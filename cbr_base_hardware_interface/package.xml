<?xml version="1.0"?>
<package format="3">
  <name>cbr_base_hardware_interface</name>
  <version>0.1.0</version>
  <description>ros2_control SystemInterface for the CBR Mariola base.</description>
  <maintainer email="todo@todo.com">author</maintainer>
  <license>GPL-3.0-only</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>cbr_interfaces</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <ros2_control plugin="cbr_base_hardware_interface_plugins.xml"/>
  </export>
</package>
