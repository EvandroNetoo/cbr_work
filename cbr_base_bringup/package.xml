<?xml version="1.0"?>
<package format="3">
  <name>cbr_base_bringup</name>
  <version>0.1.0</version>
  <description>Fixed-YAML bringup for the physical CBR mecanum base.</description>
  <maintainer email="todo@todo.com">author</maintainer>
  <license>GPL-3.0-only</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>cbr_base_description</exec_depend>
  <exec_depend>cbr_base_hardware</exec_depend>
  <exec_depend>cbr_base_hardware_interface</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>mecanum_drive_controller</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
