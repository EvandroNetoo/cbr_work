<?xml version="1.0" ?>
<robot name="so_101" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="silver">
    <color rgba="0.700 0.700 0.700 1.000"/>
  </material>

  <!-- Marcador visual do Tool Center Point no RViz. -->
  <material name="tcp_marker">
    <color rgba="1.000 0.050 0.050 1.000"/>
  </material>

  <!-- Materiais da webcam compacta fixada no punho. -->
  <material name="camera_body">
    <color rgba="0.075 0.075 0.085 1.000"/>
  </material>
  <material name="camera_lens">
    <color rgba="0.020 0.120 0.180 1.000"/>
  </material>

</robot>
