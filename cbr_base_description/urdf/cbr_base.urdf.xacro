<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cbr_base">
  <!-- Initial estimates. Replace them with measurements before physical tests.
       Dimensions are in metres and masses are in kilograms. -->
  <xacro:arg name="mock_hardware" default="true"/>
  <xacro:arg name="serial_port" default="/dev/ttyUSB0"/>
  <xacro:arg name="motor_ids" default="0,1,2,3"/>
  <xacro:arg name="motor_directions" default="1,1,1,1"/>
  <xacro:arg name="ticks_per_revolution" default="0"/>
  <xacro:arg name="max_wheel_velocity" default="0"/>

  <!-- Measurements to replace: wheels and their centre-to-centre spacing. -->
  <xacro:property name="wheel_radius" value="0.034"/>
  <xacro:property name="wheel_width" value="0.034"/>
  <xacro:property name="wheelbase" value="0.170"/>
  <xacro:property name="track_width" value="0.275"/>
  <xacro:property name="wheel_mass" value="0.35"/>

  <!-- Measurements to replace: hollow lower rectangular frame. -->
  <xacro:property name="lower_frame_length" value="0.232"/>
  <xacro:property name="lower_frame_width" value="0.232"/>
  <xacro:property name="lower_frame_height" value="0.074"/>
  <xacro:property name="lower_beam_width" value="0.008"/>
  <xacro:property name="lower_frame_ground_clearance" value="0.015"/>
  <xacro:property name="lower_frame_mass" value="6.0"/>

  <!-- Measurements to replace: solid upper platform, larger than the frame. -->
  <xacro:property name="upper_platform_length" value="0.232"/>
  <xacro:property name="upper_platform_width" value="0.306"/>
  <xacro:property name="upper_platform_thickness" value="0.008"/>
  <xacro:property name="upper_platform_mass" value="2.0"/>

  <!-- Measurements to replace: IMU box and pose relative to base_link. -->
  <xacro:property name="imu_length" value="0.039"/>
  <xacro:property name="imu_width" value="0.020"/>
  <xacro:property name="imu_height" value="0.010"/>
  <xacro:property name="imu_mass" value="0.02"/>
  <xacro:property name="imu_x" value="0.0"/>
  <xacro:property name="imu_y" value="0.0"/>
  <xacro:property name="imu_z" value="0.068"/>
  <xacro:property name="imu_roll" value="0.0"/>
  <xacro:property name="imu_pitch" value="0.0"/>
  <xacro:property name="imu_yaw" value="-1.5708"/>

  <!-- Measurements to replace: the single central orange/black LiDAR. -->
  <xacro:property name="lidar_body_length" value="0.078"/>
  <xacro:property name="lidar_body_width" value="0.078"/>
  <xacro:property name="lidar_body_height" value="0.041"/>
  <xacro:property name="lidar_orange_radius" value="0.039"/>
  <xacro:property name="lidar_orange_height" value="0.017"/>
  <xacro:property name="lidar_mass" value="0.12"/>
  <xacro:property name="lidar_center_x" value="0.075"/>
  <xacro:property name="lidar_center_y" value="0.0"/>
  <xacro:property name="lidar_center_height_above_ground" value="0.035"/>

  <!-- Derived Z positions, relative to base_link at wheel-axle height. -->
  <xacro:property name="lower_bottom_z"
    value="${lower_frame_ground_clearance - wheel_radius}"/>
  <xacro:property name="lower_top_z"
    value="${lower_bottom_z + lower_frame_height}"/>
  <xacro:property name="upper_platform_z"
    value="${lower_top_z + upper_platform_thickness / 2.0}"/>

  <material name="base_off_white"><color rgba="0.82 0.82 0.80 1"/></material>
  <material name="wheel_black"><color rgba="0.03 0.03 0.03 1"/></material>
  <material name="sensor_gray"><color rgba="0.25 0.25 0.25 1"/></material>
  <material name="lidar_orange"><color rgba="1.0 0.20 0.02 1"/></material>
  <material name="lidar_body_black"><color rgba="0.01 0.01 0.01 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <!-- Adds one rectangular member to the visual and collision geometry of a link. -->
  <xacro:macro name="frame_member" params="x y z size_x size_y size_z">
    <visual>
      <origin xyz="${x} ${y} ${z}"/>
      <geometry><box size="${size_x} ${size_y} ${size_z}"/></geometry>
      <material name="base_off_white"/>
    </visual>
    <collision>
      <origin xyz="${x} ${y} ${z}"/>
      <geometry><box size="${size_x} ${size_y} ${size_z}"/></geometry>
    </collision>
  </xacro:macro>

  <link name="base_link">
    <!-- Four lower members. -->
    <xacro:frame_member x="0" y="${lower_frame_width / 2.0 - lower_beam_width / 2.0}"
      z="${lower_bottom_z + lower_beam_width / 2.0}"
      size_x="${lower_frame_length}" size_y="${lower_beam_width}" size_z="${lower_beam_width}"/>
    <xacro:frame_member x="0" y="${-lower_frame_width / 2.0 + lower_beam_width / 2.0}"
      z="${lower_bottom_z + lower_beam_width / 2.0}"
      size_x="${lower_frame_length}" size_y="${lower_beam_width}" size_z="${lower_beam_width}"/>
    <xacro:frame_member x="${lower_frame_length / 2.0 - lower_beam_width / 2.0}" y="0"
      z="${lower_bottom_z + lower_beam_width / 2.0}"
      size_x="${lower_beam_width}" size_y="${lower_frame_width}" size_z="${lower_beam_width}"/>
    <xacro:frame_member x="${-lower_frame_length / 2.0 + lower_beam_width / 2.0}" y="0"
      z="${lower_bottom_z + lower_beam_width / 2.0}"
      size_x="${lower_beam_width}" size_y="${lower_frame_width}" size_z="${lower_beam_width}"/>

    <!-- Four upper members. -->
    <xacro:frame_member x="0" y="${lower_frame_width / 2.0 - lower_beam_width / 2.0}"
      z="${lower_top_z - lower_beam_width / 2.0}"
      size_x="${lower_frame_length}" size_y="${lower_beam_width}" size_z="${lower_beam_width}"/>
    <xacro:frame_member x="0" y="${-lower_frame_width / 2.0 + lower_beam_width / 2.0}"
      z="${lower_top_z - lower_beam_width / 2.0}"
      size_x="${lower_frame_length}" size_y="${lower_beam_width}" size_z="${lower_beam_width}"/>
    <xacro:frame_member x="${lower_frame_length / 2.0 - lower_beam_width / 2.0}" y="0"
      z="${lower_top_z - lower_beam_width / 2.0}"
      size_x="${lower_beam_width}" size_y="${lower_frame_width}" size_z="${lower_beam_width}"/>
    <xacro:frame_member x="${-lower_frame_length / 2.0 + lower_beam_width / 2.0}" y="0"
      z="${lower_top_z - lower_beam_width / 2.0}"
      size_x="${lower_beam_width}" size_y="${lower_frame_width}" size_z="${lower_beam_width}"/>

    <!-- Four vertical corner columns. -->
    <xacro:frame_member
      x="${lower_frame_length / 2.0 - lower_beam_width / 2.0}"
      y="${lower_frame_width / 2.0 - lower_beam_width / 2.0}"
      z="${lower_bottom_z + lower_frame_height / 2.0}"
      size_x="${lower_beam_width}" size_y="${lower_beam_width}" size_z="${lower_frame_height}"/>
    <xacro:frame_member
      x="${lower_frame_length / 2.0 - lower_beam_width / 2.0}"
      y="${-lower_frame_width / 2.0 + lower_beam_width / 2.0}"
      z="${lower_bottom_z + lower_frame_height / 2.0}"
      size_x="${lower_beam_width}" size_y="${lower_beam_width}" size_z="${lower_frame_height}"/>
    <xacro:frame_member
      x="${-lower_frame_length / 2.0 + lower_beam_width / 2.0}"
      y="${lower_frame_width / 2.0 - lower_beam_width / 2.0}"
      z="${lower_bottom_z + lower_frame_height / 2.0}"
      size_x="${lower_beam_width}" size_y="${lower_beam_width}" size_z="${lower_frame_height}"/>
    <xacro:frame_member
      x="${-lower_frame_length / 2.0 + lower_beam_width / 2.0}"
      y="${-lower_frame_width / 2.0 + lower_beam_width / 2.0}"
      z="${lower_bottom_z + lower_frame_height / 2.0}"
      size_x="${lower_beam_width}" size_y="${lower_beam_width}" size_z="${lower_frame_height}"/>

    <inertial>
      <!-- Bounding-box approximation until mass and centre of mass are measured. -->
      <origin xyz="0 0 ${lower_bottom_z + lower_frame_height / 2.0}"/>
      <mass value="${lower_frame_mass}"/>
      <inertia
        ixx="${lower_frame_mass * (lower_frame_width * lower_frame_width + lower_frame_height * lower_frame_height) / 12.0}"
        ixy="0" ixz="0"
        iyy="${lower_frame_mass * (lower_frame_length * lower_frame_length + lower_frame_height * lower_frame_height) / 12.0}"
        iyz="0"
        izz="${lower_frame_mass * (lower_frame_length * lower_frame_length + lower_frame_width * lower_frame_width) / 12.0}"/>
    </inertial>
  </link>

  <link name="upper_platform_link">
    <visual>
      <geometry><box size="${upper_platform_length} ${upper_platform_width} ${upper_platform_thickness}"/></geometry>
      <material name="base_off_white"/>
    </visual>
    <collision>
      <geometry><box size="${upper_platform_length} ${upper_platform_width} ${upper_platform_thickness}"/></geometry>
    </collision>
    <inertial>
      <mass value="${upper_platform_mass}"/>
      <inertia
        ixx="${upper_platform_mass * (upper_platform_width * upper_platform_width + upper_platform_thickness * upper_platform_thickness) / 12.0}"
        ixy="0" ixz="0"
        iyy="${upper_platform_mass * (upper_platform_length * upper_platform_length + upper_platform_thickness * upper_platform_thickness) / 12.0}"
        iyz="0"
        izz="${upper_platform_mass * (upper_platform_length * upper_platform_length + upper_platform_width * upper_platform_width) / 12.0}"/>
    </inertial>
  </link>
  <joint name="upper_platform_joint" type="fixed">
    <parent link="base_link"/>
    <child link="upper_platform_link"/>
    <origin xyz="0 0 ${upper_platform_z}"/>
  </joint>

  <xacro:macro name="mecanum_wheel" params="prefix x y">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin rpy="${pi / 2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin rpy="${pi / 2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"
          ixy="0" ixz="0" iyy="${wheel_mass * wheel_radius * wheel_radius / 2.0}"
          iyz="0" izz="${wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.01" friction="0.01"/>
    </joint>
  </xacro:macro>

  <xacro:mecanum_wheel prefix="front_left" x="${wheelbase / 2.0}" y="${track_width / 2.0}"/>
  <xacro:mecanum_wheel prefix="front_right" x="${wheelbase / 2.0}" y="${-track_width / 2.0}"/>
  <xacro:mecanum_wheel prefix="rear_left" x="${-wheelbase / 2.0}" y="${track_width / 2.0}"/>
  <xacro:mecanum_wheel prefix="rear_right" x="${-wheelbase / 2.0}" y="${-track_width / 2.0}"/>

  <link name="imu_link">
    <visual>
      <geometry><box size="${imu_length} ${imu_width} ${imu_height}"/></geometry>
      <material name="sensor_gray"/>
    </visual>
    <collision>
      <geometry><box size="${imu_length} ${imu_width} ${imu_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="${imu_mass}"/>
      <inertia
        ixx="${imu_mass * (imu_width * imu_width + imu_height * imu_height) / 12.0}"
        ixy="0" ixz="0"
        iyy="${imu_mass * (imu_length * imu_length + imu_height * imu_height) / 12.0}"
        iyz="0"
        izz="${imu_mass * (imu_length * imu_length + imu_width * imu_width) / 12.0}"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}"
      rpy="${imu_roll} ${imu_pitch} ${imu_yaw}"/>
  </joint>

  <link name="lidar_front_link">
    <!-- The link origin is at the orange scanner centre. -->
    <visual>
      <geometry><cylinder radius="${lidar_orange_radius}" length="${lidar_orange_height}"/></geometry>
      <material name="lidar_orange"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_orange_radius}" length="${lidar_orange_height}"/></geometry>
    </collision>
    <inertial>
      <!-- Bounding-box approximation until the LiDAR centre of mass is measured. -->
      <origin xyz="0 0 ${-(lidar_orange_height + lidar_body_height) / 2.0}"/>
      <mass value="${lidar_mass}"/>
      <inertia
        ixx="${lidar_mass * (lidar_body_width * lidar_body_width + (lidar_body_height + lidar_orange_height) * (lidar_body_height + lidar_orange_height)) / 12.0}"
        ixy="0" ixz="0"
        iyy="${lidar_mass * (lidar_body_length * lidar_body_length + (lidar_body_height + lidar_orange_height) * (lidar_body_height + lidar_orange_height)) / 12.0}"
        iyz="0"
        izz="${lidar_mass * (lidar_body_length * lidar_body_length + lidar_body_width * lidar_body_width) / 12.0}"/>
    </inertial>
  </link>
  <joint name="lidar_front_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_front_link"/>
    <origin xyz="${lidar_center_x} ${lidar_center_y} ${lidar_center_height_above_ground - wheel_radius}"
      rpy="${pi} 0 0"/>
  </joint>

  <!-- Separate component link prevents RViz from reusing the orange material
       on the black body. Both links still represent one physical LiDAR. -->
  <link name="lidar_body_link">
    <visual>
      <geometry><box size="${lidar_body_length} ${lidar_body_width} ${lidar_body_height}"/></geometry>
      <material name="lidar_body_black">
        <color rgba="0.01 0.01 0.01 1"/>
      </material>
    </visual>
    <collision>
      <geometry><box size="${lidar_body_length} ${lidar_body_width} ${lidar_body_height}"/></geometry>
    </collision>
  </link>
  <joint name="lidar_body_joint" type="fixed">
    <parent link="lidar_front_link"/><child link="lidar_body_link"/>
    <origin xyz="0 0 ${-(lidar_orange_height + lidar_body_height) / 2.0}"/>
  </joint>

  <ros2_control name="CBRMecanumSystem" type="system">
    <hardware>
      <plugin>cbr_base_hardware/MariolaSystem</plugin>
      <param name="mock_hardware">$(arg mock_hardware)</param>
      <param name="serial_port">$(arg serial_port)</param>
      <param name="baud_rate">250000</param>
      <param name="timeout_ms">10</param>
      <param name="motor_ids">$(arg motor_ids)</param>
      <param name="motor_directions">$(arg motor_directions)</param>
      <param name="ticks_per_revolution">$(arg ticks_per_revolution)</param>
      <param name="max_wheel_velocity">$(arg max_wheel_velocity)</param>
    </hardware>
    <xacro:macro name="wheel_control" params="name">
      <joint name="${name}_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:wheel_control name="front_left"/>
    <xacro:wheel_control name="front_right"/>
    <xacro:wheel_control name="rear_left"/>
    <xacro:wheel_control name="rear_right"/>
  </ros2_control>
</robot>
