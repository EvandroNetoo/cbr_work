<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema" name="robot">
  <!-- These internal mode arguments are fixed by this composed description. -->
  <xacro:arg name="arm_base_link_name" default="arm_base_link"/>
  <xacro:arg name="attach_to_mobile_base" default="true"/>
  <xacro:arg name="use_gz_ros2_control" default="false"/>
  <xacro:arg name="use_real_ros2_control" default="true"/>
  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="hardware_plugin" default="so_arm_101_hardware_interface/SO101System"/>

  <xacro:include filename="$(find base_description)/urdf/base.urdf.xacro"/>
  <xacro:include filename="$(find so_arm_101_description)/urdf/so_101.urdf.xacro"/>
  <!-- Gazebo sensors publish the same public topics as physical drivers. -->
  <xacro:if value="$(arg use_gz_ros2_control)">
    <gazebo reference="lidar_front_link">
      <preserveFixedJoint>true</preserveFixedJoint>
      <sensor name="front_lidar" type="gpu_lidar">
        <always_on>true</always_on><update_rate>10</update_rate>
        <topic>/scan_front</topic><gz_frame_id>lidar_front_link</gz_frame_id>
        <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution>
          <min_angle>-${pi}</min_angle><max_angle>${pi}</max_angle>
        </horizontal></scan><range><min>0.10</min><max>3.0</max><resolution>0.01</resolution></range></lidar>
      </sensor>
    </gazebo>
    <gazebo reference="imu_link">
      <preserveFixedJoint>true</preserveFixedJoint>
      <sensor name="imu" type="imu">
        <always_on>true</always_on><update_rate>50</update_rate>
        <topic>/imu/data</topic><gz_frame_id>imu_link</gz_frame_id>
      </sensor>
    </gazebo>
    <!-- SDF cameras look along +X. The physical lens looks along -Y. -->
    <gazebo reference="camera_link">
      <preserveFixedJoint>true</preserveFixedJoint>
      <sensor name="wrist_camera" type="camera">
        <pose>0 0 0 0 0 -1.57079632679</pose>
        <always_on>true</always_on><update_rate>15</update_rate>
        <topic>/camera/image_rect</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <camera><horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>3.0</far></clip>
        </camera>
      </sensor>
    </gazebo>
    <!-- Narrow range sensors are independent of the wide safety LiDAR. -->
    <gazebo reference="base_link">
      <sensor name="vl53_left" type="gpu_lidar">
        <pose>0.116 0.080 -0.005 0 0 0</pose>
        <always_on>true</always_on><update_rate>20</update_rate>
        <topic>/vl53/left/scan</topic><gz_frame_id>base_link</gz_frame_id>
        <lidar><scan><horizontal><samples>1</samples><min_angle>0</min_angle>
          <max_angle>0</max_angle></horizontal></scan>
          <range><min>0.02</min><max>2.0</max><resolution>0.001</resolution></range></lidar>
      </sensor>
      <sensor name="vl53_right" type="gpu_lidar">
        <pose>0.116 -0.080 -0.005 0 0 0</pose>
        <always_on>true</always_on><update_rate>20</update_rate>
        <topic>/vl53/right/scan</topic><gz_frame_id>base_link</gz_frame_id>
        <lidar><scan><horizontal><samples>1</samples><min_angle>0</min_angle>
          <max_angle>0</max_angle></horizontal></scan>
          <range><min>0.02</min><max>2.0</max><resolution>0.001</resolution></range></lidar>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
