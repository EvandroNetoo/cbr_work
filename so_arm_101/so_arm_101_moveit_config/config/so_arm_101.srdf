<?xml version="1.0"?>
<robot name="$(arg robot_name)" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="robot_name" default="so_101"/>
  <xacro:arg name="arm_base_link_name" default="base_link"/>
  <!-- Five revolute joints from the base to the wrist. -->
  <group name="arm">
    <chain base_link="$(arg arm_base_link_name)" tip_link="gripper_tcp"/>
  </group>

  <!-- Both fingers belong to the gripper; left_clamp mimics right_clamp. -->
  <group name="gripper">
    <joint name="right_clamp"/>
    <joint name="left_clamp"/>
  </group>

  <end_effector name="gripper" parent_link="link5_1" group="gripper"
                parent_group="arm"/>

  <group_state name="zero" group="arm">
    <joint name="base_link_to_link1" value="0.0"/>
    <joint name="link1_to_link2" value="0.0"/>
    <joint name="link2_to_link3" value="0.0"/>
    <joint name="link3_to_link4" value="0.0"/>
    <joint name="link4_to_link5" value="1.5707963267"/>
  </group_state>

  <group_state name="home" group="arm">
    <joint name="base_link_to_link1" value="1.57"/>
    <joint name="link1_to_link2" value="1.83"/>
    <joint name="link2_to_link3" value="-1.6"/>
    <joint name="link3_to_link4" value="1.7"/>
    <joint name="link4_to_link5" value="1.5707963267"/>
  </group_state>

  <group_state name="detect_apriltags" group="arm">
    <joint name="base_link_to_link1" value="0.0"/>
    <joint name="link1_to_link2" value="0.0"/>
    <joint name="link2_to_link3" value="1.396263"/>
    <joint name="link3_to_link4" value="-1.22173"/>
    <joint name="link4_to_link5" value="1.5707963267"/>
  </group_state>

  <!-- Posição de depósito do compartimento esquerdo: [95, 48, -60, -77, 90]°. -->
  <group_state name="deposit_cube_left" group="arm">
    <joint name="base_link_to_link1" value="1.6580627894"/>
    <joint name="link1_to_link2" value="0.8377580410"/>
    <joint name="link2_to_link3" value="-1.0471975512"/>
    <joint name="link3_to_link4" value="-1.3439035240"/>
    <joint name="link4_to_link5" value="1.5707963268"/>
  </group_state>

  <!-- Posição segura do compartimento esquerdo: [95, 44, -37, -100, 90]°. -->
  <group_state name="safe_cube_left" group="arm">
    <joint name="base_link_to_link1" value="1.6580627894"/>
    <joint name="link1_to_link2" value="0.7679448709"/>
    <joint name="link2_to_link3" value="-0.6457718232"/>
    <joint name="link3_to_link4" value="-1.7453292520"/>
    <joint name="link4_to_link5" value="1.5707963268"/>
  </group_state>

  <!-- Posição de retirada do compartimento esquerdo: [96, 48, -71, -68, 89]°. -->
  <group_state name="pick_cube_left" group="arm">
    <joint name="base_link_to_link1" value="1.6755160819"/>
    <joint name="link1_to_link2" value="0.8377580410"/>
    <joint name="link2_to_link3" value="-1.2391837689"/>
    <joint name="link3_to_link4" value="-1.1868238914"/>
    <joint name="link4_to_link5" value="1.5533430343"/>
  </group_state>

  <!-- Espelho da posição de depósito esquerda, invertendo somente a primeira junta. -->
  <group_state name="deposit_cube_right" group="arm">
    <joint name="base_link_to_link1" value="-1.6580627894"/>
    <joint name="link1_to_link2" value="0.8377580410"/>
    <joint name="link2_to_link3" value="-1.0471975512"/>
    <joint name="link3_to_link4" value="-1.3439035240"/>
    <joint name="link4_to_link5" value="1.5707963268"/>
  </group_state>

  <!-- Espelho da posição segura esquerda, invertendo somente a primeira junta. -->
  <group_state name="safe_cube_right" group="arm">
    <joint name="base_link_to_link1" value="-1.6580627894"/>
    <joint name="link1_to_link2" value="0.7679448709"/>
    <joint name="link2_to_link3" value="-0.6457718232"/>
    <joint name="link3_to_link4" value="-1.7453292520"/>
    <joint name="link4_to_link5" value="1.5707963268"/>
  </group_state>

  <!-- Espelho da posição de retirada esquerda, invertendo somente a primeira junta. -->
  <group_state name="pick_cube_right" group="arm">
    <joint name="base_link_to_link1" value="-1.6755160819"/>
    <joint name="link1_to_link2" value="0.8377580410"/>
    <joint name="link2_to_link3" value="-1.2391837689"/>
    <joint name="link3_to_link4" value="-1.1868238914"/>
    <joint name="link4_to_link5" value="1.5533430343"/>
  </group_state>

  <group_state name="place_cube_center" group="arm">
    <joint name="base_link_to_link1" value="0.0"/>
    <joint name="link1_to_link2" value="-0.0349065850"/>
    <joint name="link2_to_link3" value="0.0349065850"/>
    <joint name="link3_to_link4" value="-1.6206094969"/>
    <joint name="link4_to_link5" value="1.5707963268"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="right_clamp" value="0.037"/>
  </group_state>

  <group_state name="pre_grip" group="gripper">
    <joint name="right_clamp" value="0.024"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="right_clamp" value="0.0"/>
  </group_state>

  <group_state name="grip" group="gripper">
    <joint name="right_clamp" value="0.015"/>
  </group_state>

  <!-- Adjacent links are intentionally allowed to be in contact. -->
  <disable_collisions link1="$(arg arm_base_link_name)" link2="link1_1" reason="Adjacent"/>
  <disable_collisions link1="link1_1" link2="link2_1" reason="Adjacent"/>
  <disable_collisions link1="link2_1" link2="link3_1" reason="Adjacent"/>
  <disable_collisions link1="link3_1" link2="link4_1" reason="Adjacent"/>
  <disable_collisions link1="link3_1" link2="link1_1" reason="Adjacent"/>
  <disable_collisions link1="link4_1" link2="link5_1" reason="Adjacent"/>
  <disable_collisions link1="link5_1" link2="clamp_1" reason="Adjacent"/>
  <disable_collisions link1="link5_1" link2="clamp_2" reason="Adjacent"/>
  <disable_collisions link1="clamp_1" link2="clamp_2" reason="Default"/>
</robot>
