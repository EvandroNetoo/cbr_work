<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Módulo visual reutilizável de webcam de notebook.
    O centro do corpo fica 10 mm abaixo da superfície de montagem: como
    a câmera tem 20 mm de altura, sua face superior fica colada ao elo.
  -->
  <xacro:macro name="laptop_camera" params="parent_link camera_link:=laptop_camera mount_xyz:='0 0 0'">
    <link name="${camera_link}">
      <!-- Largura (X) 50 mm, espessura (Y) 2 mm, altura (Z) 20 mm. -->
      <visual>
        <geometry>
          <box size="0.0635 0.0026 0.0087"/>
        </geometry>
        <material name="camera_body"/>
      </visual>
      <visual>
        <!-- Lente frontal, apontada no sentido -Y. -->
        <origin xyz="0 -0.0015 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.0025" length="0.001"/>
        </geometry>
        <material name="camera_lens"/>
      </visual>
    </link>

    <!-- Sem <collision>: acessório exclusivo para visualização no RViz. -->
    <joint name="${parent_link}_to_${camera_link}" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${camera_link}"/>
      <origin xyz="-0.01 -0.04 -0.016" rpy="1.57079632679 0 0"/>
    </joint>

    <!-- ROS optical-frame convention: X right, Y down, Z forward (lens). -->
    <link name="${camera_link}_optical_frame"/>
    <joint name="${camera_link}_to_optical_frame" type="fixed">
      <parent link="${camera_link}"/>
      <child link="${camera_link}_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 3.14159265359"/>
    </joint>
  </xacro:macro>

</robot>
