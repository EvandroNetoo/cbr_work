uint32 wall_distance_mm
int32 travel_distance_mm
uint32 wall_tolerance_mm
uint32 travel_tolerance_mm
# 0 desativa o aborto por desalinhamento.
uint32 max_alignment_error_mm
# Ignora esse limite desde a primeira leitura VL53 valida; 0 aplica imediatamente.
builtin_interfaces/Duration alignment_error_ignore_duration
# Distância lateral de retorno após desalinhamento; 0 aborta imediatamente.
uint32 alignment_recovery_distance_mm
# Folga minima entre o footprint e obstaculos no lado do movimento; 0 desativa.
uint32 minimum_lateral_clearance_mm
builtin_interfaces/Duration timeout
---
bool has_valid_reading
bool has_valid_odometry
int32 final_left_distance_mm
int32 final_right_distance_mm
float32 final_average_distance_mm
# Folga entre o footprint e o obstaculo lateral detectado pelo LiDAR.
# Cada valor so e valido quando o indicador correspondente for true.
bool has_fresh_lateral_scan
bool has_valid_left_lateral_clearance
bool has_valid_right_lateral_clearance
float32 final_left_lateral_clearance_mm
float32 final_right_lateral_clearance_mm
float32 traveled_distance_mm
builtin_interfaces/Duration elapsed
string message
---
int32 raw_left_distance_mm
int32 raw_right_distance_mm
int32 left_distance_mm
int32 right_distance_mm
float32 average_distance_mm
float32 wall_distance_error_mm
float32 alignment_error_mm
float32 traveled_distance_mm
float32 travel_error_mm
float32 linear_x_velocity_mps
float32 linear_y_velocity_mps
float32 angular_velocity_rad_s
uint32 consecutive_read_failures
builtin_interfaces/Duration elapsed
